# =============================================================================
# SubNation docker-compose environment template
# =============================================================================
# R107 (Oracle/Coolify migration). Copy to `.env` next to docker-compose.yml
# and fill every REQUIRED value. Placeholders ONLY — never commit real values.
#
# This file covers the RUNTIME variables of the two compose services.
# Build-time (VITE_*) overrides are listed in docker-compose.yml itself —
# the full matrix lives in docs/deployment/ENVIRONMENT_MATRIX.md.
# =============================================================================

# ── REQUIRED — SubNation backend (boot fails without these) ─────────────────
# Neon PostgreSQL connection string (external DB stays during migration).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# 32+ chars each. Generate: openssl rand -base64 64 | tr -d '\n'
SESSION_SECRET=replace-with-random-64-char-secret
# Exactly 64 hex chars (32 bytes). Generate: openssl rand -hex 32
ENCRYPTION_KEY=replace-with-64-hex-chars
# MUST differ from SESSION_SECRET. Generate: openssl rand -base64 64 | tr -d '\n'
ADMIN_JWT_SECRET=replace-with-different-random-secret

# ── REQUIRED — origins (CORS/CSRF/Socket.IO allow-list) ─────────────────────
# Canonical production domain. Keep subnation.ly through the migration.
APP_URL=https://subnation.ly
APP_ORIGINS=https://subnation.ly,https://www.subnation.ly
# Same-origin deployment (backend serves the SPA): lax cookies are the
# stronger setting. Keep "none" ONLY for the old Vercel→Render split.
AUTH_COOKIE_SAMESITE=lax
# APP_ORIGIN is used for deep links in admin alerts (defaults to APP_URL).
APP_ORIGIN=https://subnation.ly

# ── Scheduler (R108 — single-instance economics) ────────────────────────────
# SINGLE_INSTANCE_MODE=true (R108): this container is the ONLY scheduler
# owner by declaration — no leader election, no PG-lease heartbeat, ZERO
# periodic Neon coordination queries. Idle Neon autosuspend is preserved
# (the lease heartbeat alone would have kept Neon compute awake 24/7 =
# 720 h/mo against a ~192 h free allowance). All jobs keep running
# in-process. The election machinery stays intact for a future flip-back
# (unset the flag). NEVER scale the subnation service to >1 replica in
# this mode — every cron would double-run.
SINGLE_INSTANCE_MODE=true
# Multi-instance future ONLY (inert while SINGLE_INSTANCE_MODE=true —
# kept documented for the flip-back):
# SCHEDULER_LEASE_REFRESH_MS=25000
# SCHEDULER_LEASE_TTL_SEC=60
# NEVER set true without a dedicated worker running (kills all crons).
DISABLE_WEB_SCHEDULERS=false
# Emergency-only rollback escape hatch. Keep false.
DISABLE_BOOT_MIGRATIONS=false

# ── Graceful shutdown budget (see docker-compose stop_grace_period) ─────────
# App drains in ≤25 s by default; compose waits 40 s. Override only if you
# also raise the compose stop_grace_period above it.
# GRACEFUL_SHUTDOWN_TIMEOUT_MS=25000

# ── WhatsApp gateway bridge (SubNation → openwa over the compose network) ───
# Internal service-name routing — no public exposure, no Cloudflare hop.
WHATSAPP_OTP_BASE_URL=http://openwa:2785
# MUST equal OPENWA_API_KEY below (the gateway rejects everything else).
WHATSAPP_OTP_API_KEY=replace-with-gateway-api-key
WHATSAPP_OTP_SESSION=subnation-otp
WHATSAPP_OTP_AUTO_CREATE_SESSION=true

# ── REQUIRED — openwa gateway (container exits without the API key) ─────────
OPENWA_API_KEY=replace-with-gateway-api-key
# Postgres for session persistence (same Neon DB is fine — the gateway
# self-creates its openwa_sessions table).
PERSISTENCE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Dedicated ≥32-char encryption secret for session credentials.
# openssl rand -hex 32
# (r110, 109-h) Rotation reality (openwa persist.ts): only the FIRST
# rotation — blobs still encrypted with the legacy API-key-derived key —
# is transparent (decrypted via the legacy slot + re-encrypted on first
# read). A SECOND rotation is NOT transparent: the legacy decrypt slot
# accepts the API-key derivation only, so blobs written under an earlier
# OPENWA_CREDENTIALS_KEY fail BOTH keys → treated as absent → every
# session must re-pair via QR. Generate ONCE; if rotation is ever truly
# forced, plan a QR re-pairing window for each linked session.
OPENWA_CREDENTIALS_KEY=replace-with-32-plus-char-encryption-key
# Optional operator dashboard (disabled when unset).
# DASHBOARD_USERNAME=admin
# DASHBOARD_PASSWORD=replace-with-8-plus-chars
# DASHBOARD_SESSION_SECRET=replace-with-32-plus-chars

# ── OPTIONAL — integrations (unset = cleanly disabled) ──────────────────────
# Alerting (recommended: with alerting dark, a dead checkout pages nobody)
ALERTING_ENABLED=true
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# DISCORD_WEBHOOK_URL=
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
# Backend Sentry DSN is public-by-design; frontend build arg VITE_SENTRY_DSN
# lives in docker-compose.yml, not here.
# COPILOT_PROVIDER= / COPILOT_API_KEY= / COPILOT_MODEL= / COPILOT_BASE_URL=
# FIREBASE_AUTH_ENABLED= / FIREBASE_SERVICE_ACCOUNT_JSON=
# METRICS_ADMIN_TOKEN=

# ── Compose host port bindings (defaults shown; see docker-compose.yml) ─────
# SUBNATION_HOST_PORT=127.0.0.1:3000
# OPENWA_HOST_PORT=127.0.0.1:3001
# OPENWA_REPO_DIR=../openwa
