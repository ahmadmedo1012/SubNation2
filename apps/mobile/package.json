    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "doctor": "expo-doctor",
    "export:check": "expo export --platform android --output-dir /tmp/mobile-export-check"
  },
  "dependencies": {
    "@expo/ui": "~58.0.25",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "~8.28.0",
    "@tanstack/react-query": "catalog:",
    "@workspace/api-client-native": "workspace:*",
    "@workspace/error-codes": "workspace:*",
    "expo": "~58.0.21",
    "expo-application": "~58.1.2",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.17",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.15",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.28",
