{
  "name": "@workspace/scripts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx ./src/dev.ts",
    "start": "tsx ./src/start.ts",
    "seed": "tsx ./src/seed.ts",
    "import-seo": "tsx ./src/import-seo.ts",
    "backup": "tsx ./src/backup-db.ts",
    "validate": "tsx ../scripts/validate.ts",
    "check:openapi": "tsx ../scripts/check-openapi-routes.ts",
    "check:error-codes": "tsx ../scripts/check-error-code-sync.ts",
    "check:header-params": "tsx ../scripts/check-openapi-header-params.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "validate:env": "tsx ./src/validate-production-env.ts"
  },
  "dependencies": {
    "@workspace/db": "workspace:*",
    "argon2": "^0.45.1",
    "drizzle-orm": "catalog:",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "vite": "catalog:",
    "vitest": "^5.0.5"
  }
}
