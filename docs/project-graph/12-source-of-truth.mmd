%% Source of truth — where each kind of truth actually lives (verified 2026-10-05;
%% R126 2026-10-09: the local-clone node was genericized — it named a machine-specific path)
graph TB
    subgraph Code["Code & history"]
        GITHUB["GitHub main — canonical code + history<br/>(local clones push to it; credentials never live in the repo)"]
        LOCAL["Local working clone<br/>working copy only — never canonical"]
    end

    subgraph Runtime["Runtime state"]
        COOLIFY["Coolify (169.58.100.161:8000, v4.3.23)<br/>application config + env + deployments<br/>DB: coolify-db (root SSH access)"]
        IMAGE["ghcr.io/ahmadmedo1012/subnation2 — image artifacts<br/>(since Wave 1: built BY Coolify from Git —<br/>see 03-deployment-target.mmd, the CURRENT deployment map)"]
        CONTAINER["Docker container — ephemeral runtime"]
    end

    subgraph Business["Business data"]
        NEON[("Neon Postgres — ALL business truth:<br/>products, variants, pricing, inventory,<br/>orders, wallet, ledger, users, sessions,<br/>topups, system_settings (auth configs!),<br/>openwa_sessions, audit_logs")]
    end

    subgraph Docs["Documentation"]
        HERMES[".hermes.md — agent contract"]
        DOCS["docs/ — topology (FINAL_PRODUCTION_TOPOLOGY),<br/>money invariants (FINAL_MONEY_INVARIANTS),<br/>env matrix, runbooks"]
        DEPMAP["docs/project-graph/03-deployment-target.mmd —<br/>CURRENT deployment map (Coolify git-source<br/>chain since Wave 1, 2026-10-05)"]
        GRAPH["docs/project-graph/ + project-state/ + project-plan/<br/>mission-era truth maps"]
    end

    GITHUB -->|"builds"| IMAGE
    IMAGE -->|"runs"| CONTAINER
    COOLIFY -->|"controls"| CONTAINER
    CONTAINER -->|"reads/writes business truth"| NEON
    NEON -.->|"auth.google/auth.telegram configs are DATA<br/>(admin-editable), not code"| GITHUB
