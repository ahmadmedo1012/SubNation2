# =============================================================================
# SubNation - Environment Configuration
# =============================================================================
# Copy this file to `.env` at the repo root (or `config/.env.local`) and edit
# the values. Nothing else in the codebase should need to change between
# hosting environments (local, Docker, VPS, Vercel, cPanel, Replit, ...).
#
# Load order (later wins, shell exports always win):
#   1. .env            2. .env.local
#   3. config/.env     4. config/.env.local
# =============================================================================


# -----------------------------------------------------------------------------
# Database  (required)
# -----------------------------------------------------------------------------
# PostgreSQL connection string used by the API and Drizzle migrations.
# Use the **direct** Neon URL (not the -pooler one) on Render free tier —
# pgbouncer connections drop intermittently from Render's shared NAT.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DB_POOL_MAX=15
DB_IDLE_TIMEOUT_MS=10000
DB_CONNECTION_TIMEOUT_MS=30000


# -----------------------------------------------------------------------------
# Redis  (optional — unset in current production; PG-lease + in-memory fallbacks)
# -----------------------------------------------------------------------------
# NOT provisioned since the 2026-09-20 free-tier round (see
# docs/free-tier-optimization-2026-09-20.md): the scheduler leader lock runs
# on a Postgres lease (backend/src/lib/pg-leader-lease.ts) and rate-limit /
# cache / idempotency / Socket.IO all degrade to in-process or DB guards.
# When a Redis IS provisioned, it is used by:
#   - rate-limit-redis (apiLimiter, authLimiter, OTP limiters)
#   - alerting service dedup + global rate-limit windows
#   - scheduler-coordinator leader lock + boot-migration lock
#   - worker:heartbeat key (15 s)
#   - Socket.IO Redis adapter
# Degrades loudly, never exits: with REDIS_URL set but the connection erroring,
# the app stays up on the in-memory fallbacks (single-instance deployment —
# crash-looping on a Redis blip would take the whole site down; see the H12
# note in backend/src/lib/redis-client.ts), pages via the `redis_disconnect`
# alert rule and captures to Sentry.
REDIS_URL=


# -----------------------------------------------------------------------------
# Runtime / Ports  (optional)
# -----------------------------------------------------------------------------
# These are *preferences*. The local runner auto-picks the next free port
# (up to +50) if the preferred one is busy, so you never need to edit them
# to resolve a conflict. On most PaaS providers, leave PORT unset and let
# the platform inject it.
PORT=
API_PORT=8080
FRONTEND_PORT=5173

# Base path the SPA is served under. Always "/" for Render deployment.
 # DEAD: never read by code (kept for history). Safe to delete.
BASE_PATH=/

# Public app origin used by OAuth callbacks and absolute links in emails/etc.
# In `npm run dev` this is auto-filled with the chosen frontend origin when
# APP_URL is left blank.
APP_URL=

# Comma-separated list of origins allowed by CORS. Leave empty in dev to
# allow all; set to your public origin(s) in production.
APP_ORIGINS=

# Additional exact browser origins for a split frontend deployment. These are
# consumed by CORS, CSRF and Socket.IO; never use `*` here.
FRONTEND_ORIGINS=
VERCEL_FRONTEND_ORIGIN=

# Absolute origin used to build deep-links inside admin alerts and the
# copilot/enrichment/forecast panel references (e.g. "/admin/orders" →
# "https://subnation.ly/admin/orders"). Same value as APP_URL in practice;
# kept separate so alert links survive an APP_URL change.
APP_ORIGIN=


# -----------------------------------------------------------------------------
# Auth  (required in production)
# -----------------------------------------------------------------------------
# Must be ≥ 32 random characters in production (the API throws at boot if
# shorter). Generate with:
#   openssl rand -base64 64 | tr -d '\n'
SESSION_SECRET=replace-with-a-long-random-production-secret

# Admin JWT signing secret. MUST be ≥ 32 chars AND distinct from SESSION_SECRET
# (security audit 004 / Finding F-001). Per Constitution Principle II, admin
# sessions use a separate secret so a SESSION_SECRET leak does not also forge
# admin tokens. In production the API throws at boot if this is missing or
# equals SESSION_SECRET. In dev, falls back to a derived value with a warning.
# Generate with: openssl rand -base64 64 | tr -d '\n'
ADMIN_JWT_SECRET=replace-with-a-different-long-random-admin-secret

# AES-256-GCM key for encrypting inventory account_passwords at-rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace-with-64-hex-characters

# Set to `none` when the browser SPA is hosted on a different origin (for
# example Vercel → Render). Production cookies remain Secure and HttpOnly.
AUTH_COOKIE_SAMESITE=lax

# -----------------------------------------------------------------------------
# AI Admin Copilot — LLM provider (required in production once Phase 1 ships)
# -----------------------------------------------------------------------------
# The copilot reaches an LLM through the open OpenAI-compatible Chat
# Completions HTTP protocol — used by NVIDIA NIM, OpenRouter, vLLM, and
# many other providers (the protocol name; OpenAI itself is not called).
#
# Pick a provider and obtain a bearer key:
#
#   OpenRouter   → https://openrouter.ai/keys     (key is `sk-or-v1-...`)
#   NVIDIA NIM   → https://build.nvidia.com       (key is `nvapi-...`)
#
# Set:
#   COPILOT_PROVIDER=openrouter | nvidia          (default: openrouter)
#   COPILOT_API_KEY=<the key>                     (always required)
#   COPILOT_MODEL=<model id>                      (optional; sensible default
#                                                   per provider — see
#                                                   services/copilot/provider-config.ts)
#   COPILOT_BASE_URL=<full URL>                   (optional override; bypasses
#                                                   the provider preset
#                                                   entirely if set)
#
# Switching models is a single env-var flip with no code change. Examples:
#   COPILOT_PROVIDER=openrouter
#   COPILOT_MODEL=anthropic/claude-3.5-sonnet     (cheaper: meta-llama/llama-3.3-70b-instruct)
# or
#   COPILOT_PROVIDER=nvidia
#   COPILOT_MODEL=meta/llama-3.3-70b-instruct
#
# In production the API throws on first copilot call if COPILOT_API_KEY is
# missing AND any phase flag is enabled. In dev the routes return 503.
COPILOT_PROVIDER=openrouter
COPILOT_API_KEY=
COPILOT_MODEL=
COPILOT_BASE_URL=

# Optional OAuth / notification integrations.
GOOGLE_CLIENT_ID=

# -----------------------------------------------------------------------------
# Telegram — TWO independent integrations
# -----------------------------------------------------------------------------
# Operational bot (low-stock alerts, new-order notifications, alerting
# service). Set BOTH variables to enable. Configure in @BotFather and
# add the chat where alerts should land.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Telegram LOGIN (sign-in / sign-up via Telegram Login Widget) is NOT
# configured via env vars — credentials are stored in the database
# under the `auth.telegram` system-settings key and managed entirely
# through the admin UI:
#
#   1. /admin/settings → Auth providers → Telegram → fill bot_username
#      + bot_token (from @BotFather) → toggle enabled=true → save.
#
#   2. In @BotFather:
#        /setdomain → choose bot → enter "subnation.ly"
#      (Telegram only honours widget logins for registered domains.)
#
# After both steps the provider list endpoint returns Telegram and a
# Telegram button auto-appears on /login + /register. No redeploy.

# -----------------------------------------------------------------------------
# Firebase Auth  (optional — enables Google Sign-In)
# -----------------------------------------------------------------------------
# Powers ONLY the Google login flow. Firebase Phone OTP has been
# permanently retired in favour of WhatsApp OTP — the backend hard-rejects
# any token with sign_in_provider="phone".
#
# Server-side: Firebase Admin SDK validates ID tokens at /api/auth/firebase/*.
# `FIREBASE_SERVICE_ACCOUNT_JSON` is the FULL JSON content of the admin
# service-account key, single-line escaped. Generate from:
#   Firebase Console → Project settings → Service accounts → Generate key
FIREBASE_AUTH_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Client-side: the Firebase Web SDK reads these at runtime via Vite's
# import.meta.env. The web API key is public-by-design (gated by
# Authorized Domains in Firebase Console).
# https://firebase.google.com/docs/projects/api-keys
VITE_FIREBASE_AUTH_ENABLED=false
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# DEAD: never read by code (frontend/src/lib/firebase.ts initializes without
# them; GA uses VITE_GA_TRACKING_ID). Kept for history; also removed from
# render.yaml. Safe to delete.
VITE_FIREBASE_MEASUREMENT_ID=

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX). When unset, the
# GA loader in frontend/src/lib/analytics.ts is a no-op — safe default
# for local dev, CI, and unconfigured deployments. Typically the same
# value as VITE_FIREBASE_MEASUREMENT_ID (Firebase auto-creates a linked
# GA4 stream) but kept separate so analytics can be toggled without
# touching the Firebase config. The CSP in backend/src/app.ts already
# allowlists the gtag.js + collect endpoints.
VITE_GA_TRACKING_ID=


# -----------------------------------------------------------------------------
# WhatsApp OTP via OpenWA  (optional — enables phone registration + login
# via WhatsApp text delivery). Phase 1 wires registration; login + 2FA
# reuse the same machinery in later phases. This is the SOLE phone-OTP
# path — Firebase Phone OTP has been permanently retired.
#
# When BOTH variables are unset, the WhatsApp endpoints respond with
# 503 `gateway_disabled` and the existing auth methods are unaffected.
#
# WHATSAPP_OTP_BASE_URL — full base URL of the OpenWA REST API
# WHATSAPP_OTP_API_KEY  — the api_key the OpenWA instance was launched
#                         with. Treat as a secret. Never logged. Never
#                         returned to clients.
# WHATSAPP_OTP_SESSION  — either an existing OpenWA session id (sess_…)
#                         or a session name (3–50 chars, alphanumeric +
#                         hyphens). When a name is given and no session
#                         with that name exists yet, the backend will
#                         create + start one on first send; an operator
#                         then has to scan the QR via the OpenWA
#                         dashboard before OTPs can flow.
# WHATSAPP_OTP_AUTO_CREATE_SESSION — optional. Default ON. Set to
#                         "false" to require sessions be provisioned
#                         out-of-band (no auto-create on first send).
# WHATSAPP_OTP_SETTLE_MS — optional (round-96 settle gate). Post-link
#                         settle window in ms before a freshly-paired
#                         session may dispatch OTPs. Default 45000,
#                         clamped 0–300000. Pair-code linking completes
#                         key propagation in 10–30 s; QR (device-list
#                         rebuild) can take longer. Set only to tune.
# -----------------------------------------------------------------------------
WHATSAPP_OTP_BASE_URL=
WHATSAPP_OTP_API_KEY=
WHATSAPP_OTP_SESSION=
# WHATSAPP_OTP_AUTO_CREATE_SESSION=true
# WHATSAPP_OTP_SETTLE_MS=45000


# -----------------------------------------------------------------------------
# Frontend build-time variables  (prefixed VITE_, embedded into the bundle)
# -----------------------------------------------------------------------------
# Absolute backend origin for split deployments (e.g. Vercel frontend + VPS
# API). Leave EMPTY when the backend serves the SPA from the same origin —
# the client will use relative /api paths, which is the default and works
# everywhere.
VITE_API_BASE_URL=
VITE_SOCKET_URL=
# Backward-compatible alias for older builds.
VITE_API_URL=

# Public Google OAuth client id (safe to ship in the bundle).
VITE_GOOGLE_CLIENT_ID=


# -----------------------------------------------------------------------------
# Observability / misc  (optional)
# -----------------------------------------------------------------------------
# NODE_ENV is set automatically by the dev/start scripts.
# LOG_LEVEL: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Sentry — backend
SENTRY_DSN=
# DSN aliases accepted ONLY by scripts/validate.ts's Sentry check (it
# resolves SENTRY_DSN_BACKEND → SENTRY_DSN → SENTRY_DSN_FRONTEND →
# VITE_SENTRY_DSN). Neither the server nor the frontend build reads them.
SENTRY_DSN_BACKEND=
SENTRY_DSN_FRONTEND=
# SENTRY_DEBUG=1 turns on the Sentry SDK's own verbose logging.
SENTRY_DEBUG=
# Optional CLI source-map upload (Render-side build only; never committed)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Deep links surfaced by /api/admin/observability/summary and in alert
# footers. All optional — unset = the panel hides the link.
SENTRY_DASHBOARD_URL=
RENDER_DASHBOARD_URL=
NEON_DASHBOARD_URL=
# Base URL for the alert "runbook" deep links (alerting.service appends the
# #rule anchor). Unset defaults to <APP_URL>/OPERATIONS_RUNBOOK.md.
ALERTING_RUNBOOK_URL=

# /api/metrics auth (constant-time compared)
METRICS_ADMIN_TOKEN=

# Phase 3 alerting (operational alerts, separate from business webhooks)
ALERTING_ENABLED=true
DISCORD_WEBHOOK_URL=
GENERIC_ALERT_WEBHOOK_URL=

# Anomaly-detection pipeline (003-anomaly-detection).
# Default false = pipeline scores nothing and writes no risk_events
# rows; flip to true once Foundational lands and you want the
# rules engine to start producing scores. Safe-by-default per
# spec §1 Edge Cases ("scoring service down ⇒ rules-only fallback,
# never block legitimate customers").
RISK_PIPELINE_ENABLED=false

# Inventory demand forecasting (011-inventory-demand-forecast).
# Default false = the daily cron writes no inventory_forecasts rows;
# flip to true on the worker tier once you want the panel + copilot
# tool + alerts to start producing data. Safe-by-default per
# FR-FORECAST-005 (no auto-start of any predictive pipeline).
# The runner ALSO requires WORKER_TIER=true — the cron refuses to
# run on the web tier (constitution §V scheduling rule).
FORECAST_RUNNER_ENABLED=false

# Catalog enrichment runner (012-arabic-catalog-enrichment).
# Default false = the daily cron generates no LLM drafts. Flip to true
# on the worker tier when ready. Sized at < 10% of the assessment's
# stated ROI per SC-004 — adjust the cap if pilot calibration argues
# for it. The runner refuses to run when WORKER_TIER !== "true".
ENRICHMENT_RUNNER_ENABLED=false
ENRICHMENT_DAILY_TOKEN_CAP=50000
ENRICHMENT_PER_RUN_CAP=50

# Worker-tier identity flags (read by cron runners + run records).
# WORKER_TIER: set to "true" ONLY on the dedicated worker service. The
#   forecast + enrichment crons hard-refuse to run unless this is "true",
#   which is what keeps LLM/predictive workloads off the web tier.
#   99-C2/C3 (R99-A3): Sentry subsystem tagging, logger service names and
#   diagnostics ALL read WORKER_TIER now (WORKER_ROLE is dead — see below).
# WORKER_TIER_ID: free-form label stamped on forecast/enrichment run rows
#   so operators can tell which process produced them. Any short string;
#   recorded as NULL when unset (displayed as "web" downstream).
WORKER_TIER=
# DEAD (99-C2): WORKER_ROLE was never set by any surface and its "worker"
# value matched no reader (Sentry/logger compared against "true"). All
# consumers unified on WORKER_TIER — kept here only so operators who
# followed old docs know to delete it.
WORKER_ROLE=

# NEON_API_KEY: Neon management API key — stored in the Render dashboard
# (not committed). Enables programmatic project/branch operations during
# incidents (see PLATFORM.md 2026-08-25 incident section).
NEON_API_KEY=

# Telegram approval-gateway webhook (wallet topups from the admin group).
# TELEGRAM_WEBHOOK_SECRET must match setWebhook secret_token. Bootstrap:
# send /start to the bot — it replies with your numeric chat/user IDs to put
# in TELEGRAM_ADMIN_IDS (only those accounts can press the buttons).
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_IDS=

# CSRF_ALLOWED_ORIGINS: optional override extending the Origin/Referer
# allow-list beyond APP_ORIGINS (comma-separated, exact host match).
CSRF_ALLOWED_ORIGINS=

# Worker-tier migration switch.
# Default empty/false = the web process runs heartbeat + alerting evaluator +
# cron jobs under the scheduler leader lock (Redis lock when a Redis is
# provisioned; the Postgres leader lease today — backend/src/lib/
# pg-leader-lease.ts). Set to "true" once a dedicated `subnation-worker`
# Render service exists so the web tier stops running them and the worker
# owns them.
DISABLE_WEB_SCHEDULERS=

# Boot-time schema migration switch.
# Default empty/false = on every cold start, server.ts runs
# runMigrations() under a Redis NX EX distributed lock when a Redis is
# provisioned (no Redis = single instance, runs lock-free; every statement
# is idempotent either way). All migration statements
# are idempotent (IF NOT EXISTS / IF EXISTS / DROP NOT NULL).
# Set to "true" ONLY for emergency rollbacks where a migration shipped
# in a release is broken and you need to bring up the previous binary
# against the newer schema. Production is fail-fast on critical
# migration errors when this is unset/false.
DISABLE_BOOT_MIGRATIONS=

# Sentry — frontend (Vite-public; DSN is public by design)
VITE_SENTRY_DSN=
# Release tag sent to Sentry (frontend/src/instrument.ts):
# VITE_APP_VERSION wins, else the first 7 chars of VITE_RELEASE_SHA,
# else "production"/"development". Unset on both build platforms today —
# the release tag always falls back.
VITE_RELEASE_SHA=
VITE_APP_VERSION=
VITE_APP_ORIGIN=


# -----------------------------------------------------------------------------
# Tuning knobs  (sane defaults — set only to tune; unset = default)
# -----------------------------------------------------------------------------
# Read from code with the defaults below; intentionally unset everywhere
# (render.yaml included). Verified against source — keep in sync if a
# default changes.

# Alerting rule thresholds (backend/src/services/alerting.service.ts)
# ALERT_P95_MS=1500            # api_p95_latency_high threshold (ms)
# ALERT_P95_MIN_SAMPLES=20     # min observations before the p95 rule can fire
# ALERT_5XX_RATE_PCT=5         # 5xx share (%) that fires api_5xx_rate_high
# ALERT_5XX_MIN_REQUESTS=20    # low-traffic false-positive floor (requests/window)
# ALERT_AUTH_FAILURE_DELTA=20  # auth failures in window for auth_failure_rate_high
# ALERT_LOCKOUT_DELTA=10       # lockouts in window for abnormal_lockouts
# ALERT_FIREBASE_FAIL_DELTA=5  # verifyIdToken failures for the firebase rule

# Alert side-channel throttle during DB outages (backend/src/jobs/alertLogger.ts)
# ALERT_DB_FAILURE_THROTTLE_MS=3600000   # one notify per identity per hour

# Health endpoints (backend/src/routes/health.ts)
# HEALTH_AGGREGATE_TIMEOUT_MS=8000   # /healthz/summary aggregate budget
# HEALTH_CHECK_TIMEOUT_MS=5000       # per-check race budget (redis ping, neon probe)

# Flags surfaced (informational) by /api/admin/diagnostics
# METRICS_ENABLED=true
# NEW_HEALTH_CHECKS_ENABLED=true

# Database / scheduler / migrations
# PG_STATEMENT_TIMEOUT_MS=15000        # per-connection statement_timeout; 0 = disabled (long migrations)
# SCHEDULER_OP_TIMEOUT_MS=2000        # bound for every scheduler leader-lease op
# MIGRATION_WRITE_WAIT_MAX_MS=120000  # boot: wait for Postgres to accept writes
# MIGRATION_WRITE_WAIT_POLL_MS=2000   # boot: writability poll cadence
# MIGRATION_LEADER_WAIT_MAX_MS=300000 # boot: follower wait budget (matches lock TTL)
# MIGRATION_TRANSIENT_BACKOFF_MS=5000 # boot: transient retry backoff base

# Redis paths (dormant while REDIS_URL is unset; backend/src/lib/redis-client.ts)
# REDIS_CONNECT_TIMEOUT_MS=8000
# REDIS_COMMAND_TIMEOUT_MS=500        # race budget per wrapped Redis command

# WhatsApp OTP HMAC key override (backend/src/services/whatsapp-otp.service.ts)
# OTP_HMAC_KEY=                       # >=32 chars; default derives
#                                     # HMAC(SESSION_SECRET, "whatsapp-otp-v1")

# Sentry SDK verbose logging (backend/src/lib/sentry.ts) — set to 1
# SENTRY_DEBUG=1


# -----------------------------------------------------------------------------
# Seed script defaults  (used by `npm run db:seed`)
# -----------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-before-running-seed
ADMIN_RESET_PASSWORD=false
# ALLOW_DEMO_SEED (99-C7, R99-A3 P3): opt-IN for PRODUCTION demo-catalog
# seeding (backend/src/migrate.ts). Demo seeding triggers when a boot finds
# <12 products AND it is allowed: allowed by default in any NON-production
# NODE_ENV, and in production ONLY when this is "true". Leave unset in
# production — a live catalog must never receive demo Netflix/Spotify rows.
ALLOW_DEMO_SEED=
