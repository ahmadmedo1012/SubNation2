# Files prettier should never touch.

# pnpm-lock.yaml is owned by pnpm — it writes single-quoted YAML by
# convention. Prettier's default `quoteProps: "consistent"` rewrites
# the file to double-quoted, which oscillates with every `pnpm
# install` and produces noisy 16k-line diffs that bury real changes.
pnpm-lock.yaml

# Build / cache / coverage outputs — generated, not source.
node_modules/
dist/
build/
coverage/
.next/
.turbo/

# Auto-generated API client. Not hand-edited; regenerated by orval.
shared/api-client-react/src/generated/

# Drizzle migrations — generated SQL, must round-trip exactly.
shared/db/drizzle/

# Vendored / minified assets.
**/*.min.js
**/*.min.css

# Lockfile siblings (pnpm preinstall removes these on its own).
package-lock.json
yarn.lock
