.git
.gitignore
.gitattributes
.github

# Optional local tooling clone (multi-GB); never send to Docker build context.
ruflo
ruflo/
.vscode
.idea
.cache
.local
.agents

# deps / build output (recreated inside the image)
**/node_modules
**/dist
**/build
**/out-tsc
**/.turbo
**/.next
**/coverage

# local env overrides
# FH-A6 P2-2: `**/` covers NESTED env files — a bare `.env*` only matches
# the root, so a machine-local frontend/.env.local would ride the build
# context and get baked into the public SPA bundle by a local docker build.
.env*
!config/env.example
**/.env*
!**/.env.example
# FH-A6 P3-1: operator-only secret references (gitignored; keep them out of
# build contexts too).
.secrets

# (r110) DB dump artifacts (backup-db.ts / backup-cron.sh output) — never
# send local backups into a Docker build context or bake them into images.
# `**/backups/` also covers `scripts/backups/`, where dumps actually land
# when the backup script runs via pnpm without an explicit BACKUP_DIR.
backups
backups/
**/backups/

# misc
*.log
npm-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db
*.zip
zipFile/

# R104 (AG12-7): non-build content excluded from the build context —
# ~2.3 MB of docs/specs/tooling the builder never reads.
docs
specs
.kiro
.husky
.specify
.github
*.md
.gitleaks.toml
